# ==============================================
# RecoverAI - Environment Configuration Template
# Phase 1: Foundation & Scaffold
# ==============================================

# Application Configuration
APP_NAME=RecoverAI
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# PostgreSQL Database (SQLAlchemy)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai_db

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Razorpay Configuration (Placeholders for Future Phases - DO NOT USE REAL SECRETS)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# LLM Configuration (Google Gemini)
# Set GEMINI_API_KEY in your local .env — DO NOT commit real credentials.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=10.0
LLM_TEMPERATURE=0.0

# Deterministic Safety Guard Configuration (Phase 5)
LLM_MIN_CONFIDENCE=0.70
MAX_RECOVERY_RETRIES=2

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (comma-separated or * for wildcard)
CORS_ORIGINS=*

# Background Webhook Worker Process (true on worker/demo host, false in local dev/tests)
WORKER_ENABLED=false
